{
  "name": "enterprise-ai-gateway-poc",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start.ts",
    "test": "node --test server/*.test.ts src/*.test.ts tools/*.test.mjs",
    "check": "tsc --noEmit",
    "check:public": "node tools/check-public.mjs",
    "configure:azure": "node scripts/configure-gateway.ts",
    "configure:routing-model": "node scripts/configure-routing-model.ts",
    "configure:cost-model": "node scripts/configure-cost-model.ts",
    "evaluate:routing": "node --use-system-ca scripts/evaluate-routing.ts",
    "rehearse:journey": "node scripts/rehearse-journey.ts",
    "read:policies": "node scripts/read-gateway-policies.ts",
    "configure:monitoring": "node scripts/configure-monitoring.ts",
    "read:monitoring": "node scripts/read-gateway-monitoring.ts",
    "check:databricks": "node scripts/check-databricks.ts",
    "configure:databricks": "node scripts/configure-databricks-gateway.ts",
    "configure:limits": "node scripts/configure-limits.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "license": "MIT"
}
