# Runtime configuration only. Copy to .env; never commit populated values.
# Blank origins, keys, and model names intentionally leave live calls unavailable.
# Operator settings: scripts/deployment-config.example.json -> .local/deployment-config.json
# No upstream provider credentials, workspace URLs, or saved proof belong here.

# Standalone AI Gateway (ai-gateway). Example origin shape:
# https://your-gateway.azure-api.net (use your actual supported Azure hostname)
GATEWAY_ORIGIN=
# Runtime gateway keys kept on the local Node server. B is optional for A-only use.
# Use genuinely distinct keys to test independent caller counters.
APP_A_KEY=
APP_B_KEY=
# Exact published model names; explicit selection, not intelligent routing.
MODEL_1_NAME=
MODEL_1_CLOUD=azure
MODEL_1_FORMAT=openai-chat
MODEL_1_PROVIDER=foundry
# Optional second actual provider. Cloud: azure | aws | gcp
# Format: openai-chat | anthropic-messages
# Verify the imported provider supports the selected API, then test it.
MODEL_2_NAME=
MODEL_2_CLOUD=gcp
MODEL_2_FORMAT=openai-chat
MODEL_2_PROVIDER=vertex
# Optional premium cost-comparison deployment. Provision and verify before setting.
# Routing uses the exact aliases, versions, and settings in server/model-pricing.ts;
# arbitrary models in these slots do not inherit prices or evaluated approval.
MODEL_3_NAME=
MODEL_3_CLOUD=azure
MODEL_3_FORMAT=openai-chat
MODEL_3_PROVIDER=foundry
# Optional fourth gateway alias. Enable only after publishing/configuring the backend.
# Databricks is a separate provider on Azure, not a second cloud.
# The current Databricks adapter uses a fixed native invocations route; verify
# server/gateway.ts and publish the matching model/alias before enabling this slot.
# openai-chat describes its payload, not universal endpoint normalization.
# Do not put Databricks credentials or workspace URLs in the app environment.
# Backend credentials expire independently; rotate in gateway config (see README).
MODEL_4_NAME=
MODEL_4_CLOUD=azure
MODEL_4_FORMAT=openai-chat
MODEL_4_PROVIDER=databricks
# Provider defaults when omitted: Azure=foundry, AWS=bedrock, GCP=vertex.
# Set only after verifying the model's Chat Completions parameter support.
# Match the exact generation settings pinned in server/model-pricing.ts for routing.
MODEL_1_REASONING_EFFORT=
MODEL_3_REASONING_EFFORT=
PORT=3000

# Independent APIM Premium v2 profile. Never falls back to the standalone keys/models.
# Set these only after provisioning and verifying your own matching routes.
APIM_V2_GATEWAY_ORIGIN=
APIM_V2_APP_A_KEY=
APIM_V2_APP_B_KEY=
# Allowlist: Ocp-Apim-Subscription-Key (default) | api-key
APIM_V2_AUTH_HEADER=Ocp-Apim-Subscription-Key
# Explicit operator verification of resource association; model calls do not prove it.
APIM_V2_FOUNDRY_ASSOCIATED=false
APIM_V2_MODEL_1_NAME=
APIM_V2_MODEL_1_CLOUD=azure
APIM_V2_MODEL_1_PROVIDER=foundry
APIM_V2_MODEL_1_FORMAT=openai-chat
APIM_V2_MODEL_1_REASONING_EFFORT=
APIM_V2_MODEL_1_PATH=
APIM_V2_MODEL_2_NAME=
APIM_V2_MODEL_2_CLOUD=azure
APIM_V2_MODEL_2_PROVIDER=foundry
APIM_V2_MODEL_2_FORMAT=openai-chat
APIM_V2_MODEL_2_REASONING_EFFORT=
APIM_V2_MODEL_2_PATH=
APIM_V2_MODEL_3_NAME=
APIM_V2_MODEL_3_CLOUD=azure
APIM_V2_MODEL_3_PROVIDER=foundry
APIM_V2_MODEL_3_FORMAT=openai-chat
APIM_V2_MODEL_3_REASONING_EFFORT=
APIM_V2_MODEL_3_PATH=
APIM_V2_MODEL_4_NAME=
APIM_V2_MODEL_4_CLOUD=azure
APIM_V2_MODEL_4_PROVIDER=databricks
APIM_V2_MODEL_4_FORMAT=openai-chat
APIM_V2_MODEL_4_REASONING_EFFORT=
APIM_V2_MODEL_4_PATH=
# Optional PATH is <=200 characters, /default/models/ followed by letters,
# digits, underscore, hyphen or slash; no query, dot, double slash or trailing slash.
# Blank paths use the same native routes as standalone, including Databricks invocations.
